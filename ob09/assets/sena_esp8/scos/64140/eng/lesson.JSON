a": [{"type": "text", "content": ""}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 0}], "type": "RSLT", "template_override": 1, "id": 10}, {"stimuli_ids": [], "_data": [{"contents": [{"type": "text", "content": " You need to know more about organizations and information technology. "}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "", "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}], "type": "post_instructions"}], "questions": [{"_data": [{"contents": [{"type": "pdf", "content": "enpe8n4le02ob09re7pdf01.pdf"}], "type": "question"}], "responses": [{"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}], "id": 0}], "type": "DWS", "template_override": 1, "id": 11}], "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"_data": [], "title": "", "type": "audio", "template_override": 1, "id": 1, "contents": [{"value": {"audiosrc": "enpe8n4le02ob09re2aud01", "images": [{"time": "0", "image": "enpe8n4le02ob09re2img01.jpg", "id": 0, "text": "<span class= \"strong\">Jack</span> : So, taking into account that we want to open our own business, we need to decide which organization type is the most suitable for us.<br>\n<span class= \"strong\">Sally</span> : I reviewed the three main organization types: sole proprietorship, partnership, and corporations. The kind of organization we choose will influence the load of information that our IT team has to deal with.<br>"}, {"time": "23000", "image": "enpe8n4le02ob09re2img02.jpg", "id": 1, "text": "<span class= \"strong\">Jack</span> : Indeed. If we select a simple type, like a sole proprietorship, the volume of information won't be too high. However, with a partnership, we could have more managers, and each of them could have their own system profile containing their business deals, records and so on. Information systems need to ensure that their information doesn't mix with ours or the clients', for example. In fact, the larger the organization, the more it produces data.<br>\n<span class= \"strong\">Sally</span> : Well, there are also different kinds of systems, like customer relationship management, which can save our clients' transactions, allow our employees to interact with one another, and even enable remote work. <br>"}, {"time": "67500", "image": "enpe8n4le02ob09re2img03.jpg", "id": 2, "text": "<span class= \"strong\">Jack</span> : Great! I read something about business intelligence systems. They allow businesses or firms to make their decisions based on data analysis; they can make sales predictions and probabilities on different variables.  <br>\n<span class= \"strong\">Sally</span> : I see. I know that knowledge management systems allow organizations to retain information related to business practices and innovations. Imagine, my ideas can be preserved as well as yours, and then be shared with the entire team! It won't be an easy task to decide, then!<br>\n<span class= \"strong\">Jack</span> : That's cool. We also need to think about the IT team; in order to organize it, we need people who are passionate about technology, have expertise in this field, can solve problems easily and can work in teams!<br>"}], "coverimg": "enpe8n4le02ob09re2img01.jpg"}, "type": "slideshow"}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0}]}